# ---- Core ----
# Public URL of the site (used in emails, Stripe redirects, WhatsApp links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# SQLite for local dev. For production use Postgres (see README: switch provider in prisma/schema.prisma)
DATABASE_URL="file:./dev.db"
# Used to sign admin sessions and unsubscribe links. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me
# Admin dashboard owner password (/admin) — this login is always a super admin.
# Further admins (Admin / Super admin roles) are added under /admin/team.
ADMIN_PASSWORD=change-me
# Name shown for the owner login (e.g. "Invited by" on programme invitations)
ADMIN_NAME="Muhammad Usman"

# ---- Payments (Stripe Checkout) ----
# Leave empty in local dev to use the built-in mock checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Calendar (Cal.com) ----
# e.g. "globaltalentlab/eligibility-review" -> https://cal.com/globaltalentlab/eligibility-review
# Leave empty in local dev to use the mock booking step.
NEXT_PUBLIC_CAL_LINK=
NEXT_PUBLIC_CAL_ORIGIN=https://app.cal.com
CAL_WEBHOOK_SECRET=
# Application Strategy programme sessions (60-min hidden event type), e.g. "globaltalentlab/strategy-session".
# Leave empty in local dev to use the mock booking step.
NEXT_PUBLIC_CAL_STRATEGY_LINK=

# ---- Email (Resend) ----
# Leave empty to log emails to the console instead of sending.
RESEND_API_KEY=
EMAIL_FROM="Global Talent Lab <hello@globaltalentlab.services>"
EMAIL_REPLY_TO=m.usman.uob@gmail.com
# Where new-lead / new-payment notifications go
ADMIN_NOTIFY_EMAIL=m.usman.uob@gmail.com

# ---- WhatsApp support link for programme clients (portal → Support) ----
# Either a full link (https://wa.me/447...) or just the number.
WHATSAPP_BUSINESS_URL=
WHATSAPP_BUSINESS_NUMBER=

# ---- WhatsApp Cloud API (optional) ----
# Without these, WhatsApp messages are queued in the admin dashboard as one-click wa.me links.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with 3 body params: {{1}} first name, {{2}} strength, {{3}} booking URL
WHATSAPP_TEMPLATE_INITIAL=gtl_assessment_followup
WHATSAPP_TEMPLATE_FOLLOWUP=gtl_review_reminder
WHATSAPP_TEMPLATE_LANG=en_GB

# ---- Analytics / retargeting (only load after cookie consent) ----
NEXT_PUBLIC_GA_ID=G-XFTTFDNLPJ
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=

# ---- Cron (nurture queue) ----
CRON_SECRET=change-me